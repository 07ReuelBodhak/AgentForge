# Temporary Test Evidence Artifacts (keep folder structure via .gitkeep)
evidence/task-*/
evidence/*.log
evidence/*.png
evidence/*.txt
!evidence/README.md
!evidence/.gitkeep

# Reports Output (keep folder structure via .gitkeep)
reports/tasks/*.md
!reports/tasks/.gitkeep
reports/final-report.md
!reports/README.md
!reports/.gitkeep

# Context History Output (keep folder structure via .gitkeep)
docs/project-context-history/*.md
!docs/project-context-history/.gitkeep
docs/project-context.md

# Dynamic Task Files (keep schema and folder structure via .gitkeep)
tasks/TASK-*.md
tasks/task-*.md
!tasks/task-schema.md
!tasks/.gitkeep

# Dynamic Changes (keep schema and folder structure via .gitkeep)
changes/CR-*.md
!changes/change-request-schema.md
!changes/.gitkeep

# State Overwrites
state/tester-reasoning.txt
state/failure-*.txt
state/escalation.md
